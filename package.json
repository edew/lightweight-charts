{
  "private": true,
  "version": "2.0.0",
  "name": "lightweight-charts",
  "author": "TradingView, Inc.",
  "license": "Apache-2.0",
  "description": "Financial lightweight charts built with HTML5 canvas",
  "bugs": {
    "url": "https://github.com/tradingview/lightweight-charts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tradingview/lightweight-charts.git"
  },
  "type": "module",
  "main": "./dist/lightweight-charts.umd.cjs",
  "module": "./dist/lightweight-charts.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lightweight-charts.js",
      "require": "./dist/lightweight-charts.umd.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "keywords": [
    "financial-charting-library",
    "charting-library",
    "html5-charts",
    "canvas",
    "typescript",
    "charting",
    "charts"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run tests/**/**.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "knip": "knip",
    "test:visual": "vitest run tests/visual",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@types/chai": "5.2.2",
    "@types/node": "24.5.2",
    "chai": "5.2.1",
    "dejavu-fonts-ttf": "2.37.3",
    "eslint": "^10.8.0",
    "knip": "^6.31.0",
    "pixelmatch": "8.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
